---
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  aspect?: string;
}

const {
  src,
  alt,
  class: className = '',
  width = 800,
  height = 1000,
  loading = 'lazy',
  fetchpriority,
  aspect,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const imageSrc = src.startsWith('http') ? src : `${base}${src.replace(/^\//, '')}`;
---

<div class={`site-image ${className}`} style={aspect ? `aspect-ratio: ${aspect}` : undefined}>
  <img
    src={imageSrc}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class="site-image__img"
  />
</div>

<style>
  .site-image {
    position: relative;
    overflow: hidden;
    background: var(--color-graphite-soft);
  }

  .site-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
</style>
