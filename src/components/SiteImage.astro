---
interface Props {
  class?: string;
  aspect?: string;
  label?: string;
}

const {
  class: className = '',
  aspect = '4 / 5',
  label = 'Нет фото',
} = Astro.props;
---

<div
  class={`site-image ${className}`}
  style={`aspect-ratio: ${aspect}`}
  role="img"
  aria-label={label}
>
  <div class="site-image__frame" aria-hidden="true"></div>
  <div class="site-image__content" aria-hidden="true">
    <span class="site-image__rule"></span>
    <span class="site-image__label">{label}</span>
    <span class="site-image__rule"></span>
  </div>
</div>

<style>
  .site-image {
    position: relative;
    overflow: hidden;
    width: 100%;
    background:
      linear-gradient(
        160deg,
        rgba(196, 176, 138, 0.07) 0%,
        transparent 42%,
        rgba(14, 14, 16, 0.15) 100%
      ),
      var(--color-graphite-soft);
    border: 1px solid rgba(196, 176, 138, 0.22);
  }

  .site-image__frame {
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(196, 176, 138, 0.14);
    pointer-events: none;
  }

  .site-image__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
  }

  .site-image__label {
    font-family: var(--font-display);
    font-size: clamp(0.6875rem, 1.4vw, 0.8125rem);
    font-weight: 400;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-champagne);
    opacity: 0.72;
  }

  .site-image__rule {
    display: block;
    width: 2.25rem;
    height: 1px;
    background: var(--color-champagne-dim);
  }

  :global(.section--ivory) .site-image {
    background:
      linear-gradient(
        160deg,
        rgba(196, 176, 138, 0.1) 0%,
        transparent 48%,
        rgba(154, 146, 136, 0.08) 100%
      ),
      var(--color-ivory-muted);
    border-color: rgba(196, 176, 138, 0.32);
  }

  :global(.section--ivory) .site-image__frame {
    border-color: rgba(196, 176, 138, 0.22);
  }

  :global(.section--ivory) .site-image__label {
    color: var(--color-taupe);
    opacity: 0.85;
  }

  :global(.section--ivory) .site-image__rule {
    background: rgba(196, 176, 138, 0.4);
  }
</style>
