---
import { trustItems } from '../data/site';
---

<section class="trust section" id="trust" aria-labelledby="trust-title">
  <div class="container">
    <h2 class="section-title reveal" id="trust-title">
      Почему нам доверяют
    </h2>

    <ul class="trust__grid">
      {
        trustItems.map((item, i) => (
          <li class={`trust__item reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <span class="trust__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="trust__title">{item.title}</h3>
            <p class="trust__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust__grid {
    display: grid;
    gap: 1px;
    margin-top: var(--space-xl);
    background: rgba(196, 176, 138, 0.12);
    border: 1px solid rgba(196, 176, 138, 0.12);
  }

  .trust__item {
    padding: var(--space-lg);
    background: var(--color-graphite);
  }

  .trust__index {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--color-champagne);
    margin-bottom: var(--space-md);
  }

  .trust__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: var(--space-sm);
    color: var(--color-ivory);
  }

  .trust__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 32ch;
  }

  @media (min-width: 768px) {
    .trust__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
