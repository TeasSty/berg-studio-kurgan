---
import { trustItems } from '../data/site';
---

<section class="trust section section--ivory" id="trust" aria-labelledby="trust-title">
  <div class="container">
    <header class="section-header reveal">
      <p class="section-label">Проверено</p>
      <h2 class="section-title" id="trust-title">Почему нам доверяют</h2>
    </header>

    <ul class="stat-grid">
      {
        trustItems.map((item, i) => (
          <li class={`stat-block reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <span class="stat-block__label">{item.title}</span>
            <p class="trust__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust .stat-block {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .trust .stat-block__label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .trust__text {
    font-size: 0.9375rem;
    color: var(--color-text-dark-muted);
    max-width: 36ch;
    flex: 1;
  }
</style>
