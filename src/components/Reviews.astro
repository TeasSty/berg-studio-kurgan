---
import { reviews, site, ratings } from '../data/site';
---

<section class="reviews section section--ivory" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <header class="section-header section-header--row reveal">
      <div>
        <p class="section-label">Отзывы</p>
        <h2 class="section-title" id="reviews-title">Что говорят клиенты</h2>
      </div>
      <ul class="reviews__stats" aria-label="Рейтинги">
        {
          ratings.map((r) => (
            <li class="reviews__stat">
              <span class="reviews__stat-value">{r.value}</span>
              <span class="reviews__stat-label">{r.label}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <ul class="reviews__grid">
      {
        reviews.map((review, i) => (
          <li class={`reviews__card card reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <blockquote class="reviews__quote">
              <p>«{review.text}»</p>
            </blockquote>
            <footer class="reviews__footer">
              <cite class="reviews__author">{review.name}</cite>
              <time class="reviews__date" datetime={review.date}>{review.date}</time>
            </footer>
          </li>
        ))
      }
    </ul>

    <div class="reviews__cta reveal">
      <p class="reviews__cta-text">Больше отзывов — VK и Dikidi.</p>
      <a href={site.vk} class="btn btn--dark" target="_blank" rel="noopener noreferrer">
        Открыть VK
      </a>
    </div>
  </div>
</section>

<style>
  .reviews__stats {
    display: flex;
    gap: var(--space-lg);
  }

  .reviews__stat {
    display: flex;
    flex-direction: column;
  }

  .reviews__stat-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-text-dark);
    line-height: 1;
  }

  .reviews__stat-label {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-taupe);
  }

  .reviews__grid {
    display: grid;
    gap: var(--space-sm);
  }

  .reviews__card {
    display: flex;
    flex-direction: column;
  }

  .reviews__quote {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-dark);
    flex: 1;
  }

  .reviews__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border-light);
  }

  .reviews__author {
    font-style: normal;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-taupe);
  }

  .reviews__date {
    font-size: 0.75rem;
    color: var(--color-taupe);
  }

  .reviews__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border-light);
  }

  .reviews__cta-text {
    font-size: 0.9375rem;
    color: var(--color-text-dark-muted);
  }

  @media (min-width: 768px) {
    .reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
