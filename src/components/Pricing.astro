---
import { pricingCategories, site } from '../data/site';
---

<section class="pricing section" id="pricing" aria-labelledby="pricing-title">
  <div class="container container--narrow">
    <header class="section-header reveal">
      <p class="section-label">Прайс</p>
      <h2 class="section-title" id="pricing-title">Стоимость процедур</h2>
      <p class="section-lead">
        Цена зависит от зоны и препарата. Точную сумму скажем на консультации.
      </p>
    </header>

    <div class="pricing__categories">
      {
        pricingCategories.map((category, ci) => (
          <div class={`pricing__category reveal reveal-delay-${Math.min(ci + 1, 4)}`}>
            <h3 class="pricing__category-name">{category.name}</h3>
            <ul class="pricing__list">
              {category.items.map((item) => (
                <li class="pricing__item">
                  <span class="pricing__name">{item.name}</span>
                  <span class="pricing__price">{item.price}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="pricing__note reveal">
      Цены — по данным VK. Уточняйте при записи.
    </p>

    <a
      href={site.vkMessage}
      class="btn btn--primary reveal"
      target="_blank"
      rel="noopener noreferrer"
    >
      Записаться
    </a>
  </div>
</section>

<style>
  .pricing__categories {
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .pricing__category-name {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-champagne);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .pricing__list {
    display: flex;
    flex-direction: column;
  }

  .pricing__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-border);
  }

  .pricing__name {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .pricing__price {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ivory);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pricing__note {
    margin-top: var(--space-lg);
    font-size: 0.8125rem;
    color: var(--color-taupe);
    max-width: 48ch;
  }

  .pricing .btn {
    margin-top: var(--space-md);
  }
</style>
