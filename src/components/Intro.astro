---
import { site, ratings } from '../data/site';
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="container about__inner">
    <div class="about__content">
      <header class="section-header reveal">
        <p class="section-label">О нас</p>
        <h2 class="section-title" id="about-title">О студии</h2>
      </header>

      <div class="about__text reveal reveal-delay-1">
        <p>
          Добро пожаловать в студию косметологии и красоты Berg studio.
          {site.city}, 2-й микрорайон, 8.
        </p>
        <p>
          Мы — дипломированные косметологи с медицинским образованием и действующей
          аккредитацией. Лауреаты премии Топ-100 успешных людей Курганской
          области. После посещения остаёмся на связи по всем вопросам.
        </p>
        <p>
          Принцип работы простой: не навреди. Подбираем процедуру после
          консультации и осмотра — не «на глаз».
        </p>
      </div>
    </div>

    <aside class="about__aside reveal reveal-delay-2" aria-label="Рейтинги">
      <ul class="stat-grid">
        {
          ratings.map((r) => (
            <li class="stat-block">
              <span class="stat-block__value">{r.value}</span>
              <span class="stat-block__label">{r.label}</span>
            </li>
          ))
        }
        <li class="stat-block about__stat-full">
          <span class="stat-block__label">Запись</span>
          <span class="stat-block__detail">{site.hours}</span>
        </li>
        <li class="stat-block about__stat-full">
          <span class="stat-block__label">Адрес</span>
          <span class="stat-block__detail">{site.fullAddress}</span>
        </li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 56ch;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .about__stat-full {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .about__inner {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-3xl);
    }
  }
</style>
