---
import { site } from '../data/site';
---

<section class="intro section section--ivory" id="intro" aria-labelledby="intro-title">
  <div class="container intro__inner">
    <div class="intro__content">
      <h2 class="section-title reveal" id="intro-title">
        О&nbsp;студии
      </h2>
      <p class="intro__text reveal reveal-delay-1">
        BERG STUDIO — кабинет косметологии в Кургане, 2-й микрорайон, 8.
        Инъекции, аппаратные методики, уход за кожей.
      </p>
      <p class="intro__text reveal reveal-delay-2">
        Работаем с медицинским образованием и аккредитацией. Для нас важны
        стерильность, аккуратность и честный разговор до процедуры.
        Сначала консультация — потом индивидуальный план.
      </p>
    </div>

    <aside class="intro__aside reveal reveal-delay-2" aria-label="Принцип работы">
      <div class="editorial-panel editorial-panel--quote">
        <span class="editorial-panel__quote-mark" aria-hidden="true">«</span>
        <p class="editorial-panel__quote-text">Не навреди — и&nbsp;сделай красиво</p>
        <p class="editorial-panel__quote-author">{site.name}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .intro__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .intro__text {
    margin-top: var(--space-md);
    max-width: 48ch;
    color: var(--color-text-dark-muted);
    font-size: 1.0625rem;
  }

  @media (min-width: 1024px) {
    .intro__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-3xl);
    }

    .intro__aside {
      justify-self: end;
    }
  }
</style>
