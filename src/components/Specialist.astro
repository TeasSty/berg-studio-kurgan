---
import { site } from '../data/site';
import SiteImage from './SiteImage.astro';
---

<section class="specialist section section--ivory" id="specialist" aria-labelledby="specialist-title">
  <div class="container specialist__inner">
    <div class="specialist__visual reveal">
      <SiteImage class="specialist__image" aspect="4 / 5" />
    </div>

    <div class="specialist__content">
      <p class="section-label reveal">Specialist</p>
      <h2 class="section-title reveal reveal-delay-1" id="specialist-title">
        Жанна
      </h2>
      <p class="specialist__role reveal reveal-delay-2">
        Дипломированный косметолог · медицинское образование · аккредитация
      </p>

      <div class="specialist__badge reveal reveal-delay-2" aria-label={site.award}>
        <span class="specialist__badge-year">2025</span>
        <span class="specialist__badge-text">Лучший косметолог Курганской области</span>
      </div>

      <div class="gold-line reveal reveal-delay-2"></div>

      <div class="specialist__text reveal reveal-delay-3">
        <p>
          Пришла из строгой режимной медицины в косметологию — и нашла здесь
          то, что действительно важно: творить красоту, не забывая о безопасности.
          Руководствуюсь принципом «не навреди».
        </p>
        <p>
          Лауреат премии Топ-100 успешных людей Курганской области.
          Сейчас получаю высшее медицинско-экономическое образование и
          постоянно прохожу дополнительное обучение в сфере косметологии.
        </p>
      </div>

      <ul class="specialist__facts reveal reveal-delay-4">
        <li>
          <strong>Образование</strong>
          <span>Медицинское образование, действующая аккредитация</span>
        </li>
        <li>
          <strong>Подход</strong>
          <span>Индивидуальный план, бережная тактика, естественный результат</span>
        </li>
        <li>
          <strong>Развитие</strong>
          <span>Непрерывное обучение у лучших специалистов отрасли</span>
        </li>
        <li>
          <strong>Связь</strong>
          <span>Остаюсь на связи после процедуры по всем вопросам</span>
        </li>
      </ul>

      <a
        href={site.vkMessage}
        class="btn btn--dark reveal reveal-delay-4"
        target="_blank"
        rel="noopener noreferrer"
      >
        Записаться на консультацию
      </a>
    </div>
  </div>
</section>

<style>
  .specialist__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .specialist__visual {
    max-width: 480px;
    margin-inline: auto;
    width: 100%;
  }

  .specialist__image {
    width: 100%;
  }

  .specialist__role {
    margin-top: var(--space-sm);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-taupe);
  }

  .specialist__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding: 0.75rem 1rem;
    background: var(--color-graphite);
    color: var(--color-ivory);
    border: 1px solid var(--color-champagne-dim);
  }

  .specialist__badge-year {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-champagne);
    line-height: 1;
    flex-shrink: 0;
  }

  .specialist__badge-text {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .specialist__text {
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 48ch;
    color: var(--color-text-dark-muted);
    font-size: 1.0625rem;
  }

  .specialist__facts {
    margin-block: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .specialist__facts li {
    padding-left: var(--space-md);
    border-left: 1px solid var(--color-champagne-dim);
  }

  .specialist__facts strong {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-taupe);
    margin-bottom: 0.25rem;
    font-weight: 500;
  }

  .specialist__facts span {
    font-size: 0.9375rem;
    color: var(--color-text-dark);
  }

  @media (min-width: 1024px) {
    .specialist__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-3xl);
      align-items: center;
    }

    .specialist__visual {
      margin-inline: 0;
    }
  }
</style>
