---
import { site, proofFacts } from '../data/site';
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__main">
      <p class="hero__award reveal">{site.award} · {site.awardDetail}</p>

      <h1 class="hero__title reveal reveal-delay-1" id="hero-title">
        Косметология в&nbsp;{site.city} с&nbsp;медицинским образованием
      </h1>

      <p class="hero__motto reveal reveal-delay-2">{site.motto}</p>

      <ul class="hero__proof reveal reveal-delay-2" aria-label="Ключевые факты">
        <li>Диплом и аккредитация</li>
        <li>Кабинет по СанПин</li>
        <li>Запись — VK или телефон</li>
      </ul>

      <div class="hero__actions reveal reveal-delay-3">
        <a href={site.vkMessage} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
          Записаться
        </a>
        <a href="#services" class="btn btn--ghost">Услуги и цены</a>
      </div>
    </div>

    <aside class="hero__aside reveal reveal-delay-2" aria-label="Контакты и факты">
      <div class="hero__address-block">
        <p class="hero__address-label">Адрес</p>
        <p class="hero__address">{site.fullAddress}</p>
        <p class="hero__hours">{site.hours}</p>
        <a href={`tel:${site.phone}`} class="hero__phone">{site.phoneDisplay}</a>
      </div>

      <ul class="stat-grid hero__stats">
        {
          proofFacts.map((fact) => (
            <li class="stat-block">
              <span class="stat-block__value">{fact.value}</span>
              <span class="stat-block__label">{fact.label}</span>
              <span class="stat-block__detail">{fact.detail}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-height) + var(--space-xl));
    padding-bottom: var(--space-2xl);
    background: var(--color-graphite);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .hero__award {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-champagne);
    margin-bottom: var(--space-md);
    max-width: 40ch;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.1;
    max-width: 16ch;
    color: var(--color-ivory);
  }

  .hero__motto {
    margin-top: var(--space-sm);
    font-size: 0.9375rem;
    color: var(--color-taupe);
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-md);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .hero__proof li {
    position: relative;
    padding-left: 0.875rem;
  }

  .hero__proof li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-champagne);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero__address-block {
    padding: var(--space-md);
    background: var(--color-graphite-soft);
    border: 1px solid var(--color-border);
  }

  .hero__address-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-champagne);
    margin-bottom: 0.375rem;
  }

  .hero__address {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-ivory);
  }

  .hero__hours {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-taupe);
  }

  .hero__phone {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-champagne);
    transition: color var(--transition-fast);
  }

  .hero__phone:hover {
    color: var(--color-ivory);
  }

  .hero__stats {
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-3xl);
    }
  }
</style>
