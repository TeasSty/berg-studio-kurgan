---
import { site } from '../data/site';
import SiteImage from './SiteImage.astro';
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__gradient"></div>
    <div class="hero__line hero__line--1"></div>
    <div class="hero__line hero__line--2"></div>
  </div>

  <div class="hero__inner container">
    <div class="hero__intro">
      <div class="hero__badge reveal">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        {site.award}
      </div>

      <h1 class="hero__title" id="hero-title">
        <span class="hero__title-line reveal">BERG</span>
        <span class="hero__title-line hero__title-line--sub reveal reveal-delay-1">STUDIO</span>
      </h1>

      <p class="hero__tagline reveal reveal-delay-2">{site.tagline}</p>
    </div>

    <div class="hero__visual reveal reveal-delay-2">
      <SiteImage
        src="/images/hero/specialist.jpg"
        alt="Косметолог BERG STUDIO в кабинете студии, Курган"
        class="hero__image"
        width={640}
        height={800}
        loading="eager"
        fetchpriority="high"
        aspect="4 / 5"
      />
      <div class="hero__visual-frame" aria-hidden="true"></div>
    </div>

    <div class="hero__details">
      <div class="gold-line hero__gold-line reveal reveal-delay-2"></div>

      <p class="hero__quote reveal reveal-delay-3">
        Эстетика, основанная<br />на медицинском подходе
      </p>

      <ul class="hero__meta reveal reveal-delay-3" aria-label="Ключевые преимущества">
        <li>Медицинское образование</li>
        <li>Стерильность и точность</li>
        <li>Индивидуальный план</li>
      </ul>

      <div class="hero__actions reveal reveal-delay-4">
        <a href={site.vkMessage} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
          Записаться на консультацию
        </a>
        <a href="#procedures" class="btn btn--ghost">Исследовать процедуры</a>
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 60% at 70% 40%,
      rgba(196, 176, 138, 0.06) 0%,
      transparent 60%
    );
  }

  .hero__line {
    position: absolute;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-champagne-dim),
      transparent
    );
  }

  .hero__line--1 {
    top: 28%;
    left: 0;
    right: 30%;
  }

  .hero__line--2 {
    bottom: 22%;
    left: 20%;
    right: 0;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-xl);
    min-height: calc(100svh - var(--header-height));
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem;
    margin-bottom: var(--space-lg);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-champagne);
    border: 1px solid var(--color-champagne-dim);
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-champagne);
    animation: pulse 2.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .hero__title-line {
    display: block;
    font-size: clamp(3.5rem, 12vw, 7.5rem);
    color: var(--color-ivory);
  }

  .hero__title-line--sub {
    font-size: clamp(2.5rem, 8vw, 5rem);
    color: var(--color-champagne);
    font-style: italic;
    margin-top: -0.05em;
  }

  .hero__tagline {
    margin-top: var(--space-sm);
    font-size: 0.6875rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-taupe);
  }

  .hero__gold-line {
    margin-block: var(--space-md) var(--space-lg);
  }

  .hero__quote {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-text-muted);
    max-width: 18ch;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: var(--space-lg);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-taupe);
  }

  .hero__meta li:not(:last-child)::after {
    content: '·';
    margin-left: 1.5rem;
    color: var(--color-champagne-dim);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .hero__visual {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
  }

  .hero__image {
    width: 100%;
  }

  .hero__visual-frame {
    position: absolute;
    inset: -12px -12px 12px 12px;
    border: 1px solid var(--color-champagne-dim);
    pointer-events: none;
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-taupe);
  }

  .hero__scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--color-champagne), transparent);
    animation: scrollLine 2s ease-in-out infinite;
  }

  @keyframes scrollLine {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50% { transform: scaleY(0.6); opacity: 0.5; }
  }

  @media (min-width: 768px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr 0.85fr;
      grid-template-rows: auto 1fr;
      gap: var(--space-2xl);
    }

    .hero__intro,
    .hero__details {
      grid-column: 1;
    }

    .hero__visual {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: center;
      width: 100%;
      max-width: 480px;
      justify-self: end;
    }

    .hero__scroll {
      display: flex;
    }

    .hero__meta li:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .hero__visual {
      width: 100%;
      max-width: 360px;
      margin-inline: auto;
    }

    .hero__badge {
      margin-bottom: var(--space-md);
    }

    .hero__title-line {
      font-size: clamp(2.75rem, 14vw, 4rem);
    }

    .hero__title-line--sub {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .hero__meta li {
      width: 100%;
    }

    .hero__meta li::after {
      display: none !important;
    }

    .hero__scroll {
      display: none;
    }
  }
</style>
