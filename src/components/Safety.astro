---
import { safetyPoints } from '../data/site';
---

<section class="safety section" id="safety" aria-labelledby="safety-title">
  <div class="container container--narrow">
    <header class="section-header reveal">
      <p class="section-label">Безопасность</p>
      <h2 class="section-title" id="safety-title">Кабинет по СанПин</h2>
      <p class="section-lead">
        Отдельное внимание — безопасности. Кабинет оборудован по нормам
        СанПин. В работе — только одноразовые и стерильные расходники.
      </p>
    </header>

    <ol class="safety__list">
      {
        safetyPoints.map((point, i) => (
          <li class={`fact-row reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <span class="fact-row__marker" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="fact-row__title">{point.title}</h3>
              <p class="fact-row__text">{point.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .safety__list {
    margin-top: var(--space-md);
  }
</style>
