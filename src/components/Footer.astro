---
import { site, navLinks } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__logo">{site.name}</p>
      <p class="footer__tagline">{site.motto}</p>
      <p class="footer__address">{site.fullAddress}</p>
      <p class="footer__hours">{site.hours}</p>
    </div>

    <nav class="footer__nav" aria-label="Навигация в подвале">
      <ul>
        {
          navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__contact">
      <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
      <a href={site.vk} target="_blank" rel="noopener noreferrer">vk.ru/cosmo_45</a>
      <a href={site.vkMessage} target="_blank" rel="noopener noreferrer">Записаться в VK</a>
    </div>
  </div>

  <div class="footer__bottom container">
    <p>&copy; {year} {site.name}. {site.city}.</p>
    {
      site.isDraft && (
        <p class="footer__draft">Черновая версия · фото и материалы будут добавлены</p>
      )
    }
    <p class="footer__legal">
      Имеются противопоказания. Необходима консультация специалиста.
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-xl) var(--space-lg);
    background: var(--color-graphite-soft);
    border-top: 1px solid var(--color-border);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-ivory);
  }

  .footer__tagline {
    font-size: 0.8125rem;
    color: var(--color-taupe);
    margin-top: 0.25rem;
  }

  .footer__address,
  .footer__hours {
    margin-top: var(--space-sm);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .footer__nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer__nav a {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer__nav a:hover {
    color: var(--color-champagne);
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__contact a {
    font-size: 0.875rem;
    color: var(--color-ivory);
    transition: color var(--transition-fast);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .footer__contact a:hover {
    color: var(--color-champagne);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: var(--space-md);
    font-size: 0.75rem;
    color: var(--color-taupe);
  }

  .footer__draft {
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: rgba(154, 146, 136, 0.75);
  }

  .footer__legal {
    max-width: 44ch;
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .footer__inner {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }
</style>
