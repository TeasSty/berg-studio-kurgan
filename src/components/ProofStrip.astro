---
import { proofStripItems } from '../data/site';
---

<div class="proof-strip" id="proof-strip" aria-hidden="true">
  <div class="proof-strip__inner container">
    {
      proofStripItems.map((item, i) => (
        <>
          <span class="proof-strip__item">{item}</span>
          {i < proofStripItems.length - 1 && (
            <span class="proof-strip__sep" aria-hidden="true">·</span>
          )}
        </>
      ))
    }
  </div>
</div>

<style>
  .proof-strip {
    position: fixed;
    top: var(--header-height);
    inset-inline: 0;
    z-index: 99;
    height: var(--proof-strip-height);
    background: rgba(22, 22, 24, 0.96);
    border-bottom: 1px solid var(--color-border);
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .proof-strip.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  .proof-strip.is-menu-hidden {
    transform: translateY(-100%) !important;
    opacity: 0 !important;
  }

  .proof-strip__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-taupe);
  }

  .proof-strip__item {
    color: var(--color-ivory);
  }

  .proof-strip__sep {
    color: var(--color-champagne-dim);
  }

  @media (max-width: 480px) {
    .proof-strip__inner {
      font-size: 0.625rem;
      gap: 0.375rem;
    }
  }
</style>
