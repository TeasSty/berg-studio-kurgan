---
import { procedures, site } from '../data/site';
---

<section class="procedures section" id="procedures" aria-labelledby="procedures-title">
  <div class="container">
    <div class="procedures__header">
      <h2 class="section-title reveal" id="procedures-title">
        Процедуры
      </h2>
      <p class="procedures__lead reveal reveal-delay-1">
        Подбираем методику после консультации — с учётом кожи, возраста
        и того, чего вы хотите добиться.
      </p>
    </div>

    <ul class="procedures__grid">
      {
        procedures.map((item, i) => (
          <li
            class={`procedures__card${item.featured ? ' procedures__card--featured' : ''} reveal reveal-delay-${Math.min((i % 4) + 1, 4)}`}
          >
            <a href={site.vkMessage} class="procedures__link" target="_blank" rel="noopener noreferrer">
              <span class="procedures__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="procedures__body">
                <h3 class="procedures__title">{item.title}</h3>
                <p class="procedures__desc">{item.description}</p>
                <div class="procedures__footer">
                  <span class="procedures__price">{item.price}</span>
                  <span class="procedures__cta">Записаться →</span>
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .procedures__header {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .procedures__lead {
    max-width: 40ch;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .procedures__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgba(196, 176, 138, 0.1);
  }

  .procedures__card {
    background: var(--color-graphite-soft);
    overflow: hidden;
  }

  .procedures__link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
    padding: var(--space-lg);
    height: 100%;
    transition: background var(--transition-fast);
  }

  .procedures__link:hover {
    background: rgba(26, 26, 28, 0.8);
  }

  .procedures__link:hover .procedures__cta {
    color: var(--color-champagne);
  }

  .procedures__index {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: rgba(196, 176, 138, 0.35);
    padding-top: 0.125rem;
  }

  .procedures__body {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .procedures__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: var(--space-xs);
    color: var(--color-ivory);
  }

  .procedures__desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    flex: 1;
    max-width: 40ch;
  }

  .procedures__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
  }

  .procedures__price {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-champagne);
  }

  .procedures__cta {
    font-size: 0.75rem;
    color: var(--color-taupe);
    transition: color var(--transition-fast);
  }

  @media (min-width: 768px) {
    .procedures__header {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }

    .procedures__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .procedures__card--featured {
      grid-column: span 2;
    }

    .procedures__card--featured .procedures__title {
      font-size: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .procedures__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .procedures__card--featured {
      grid-column: span 2;
    }
  }
</style>
