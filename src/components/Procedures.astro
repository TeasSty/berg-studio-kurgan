---
import { procedures, site } from '../data/site';
---

<section class="services section section--ivory" id="services" aria-labelledby="services-title">
  <div class="container">
    <header class="section-header section-header--row reveal">
      <div>
        <p class="section-label">Услуги</p>
        <h2 class="section-title" id="services-title">Процедуры и цены</h2>
        <p class="section-lead">
          Цены — по данным VK. Точную сумму скажем на консультации.
        </p>
      </div>
      <a href={site.vk} class="btn btn--dark" target="_blank" rel="noopener noreferrer">
        Все услуги в VK
      </a>
    </header>

    <ul class="services__grid">
      {
        procedures.map((item, i) => (
          <li class={`services__item reveal reveal-delay-${Math.min((i % 4) + 1, 4)}`}>
            <a href={site.vkMessage} class="services__link" target="_blank" rel="noopener noreferrer">
              <div class="services__head">
                <h3 class="services__title">{item.title}</h3>
                <span class="services__price">{item.price}</span>
              </div>
              <p class="services__desc">{item.description}</p>
              <span class="services__cta">Записаться →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    gap: var(--space-sm);
  }

  .services__item {
    border: 1px solid var(--color-border-light);
    background: var(--color-ivory-muted);
  }

  .services__link {
    display: block;
    padding: var(--space-md);
    transition: background var(--transition-fast);
  }

  .services__link:hover {
    background: rgba(232, 228, 220, 0.6);
  }

  .services__link:hover .services__cta {
    color: var(--color-text-dark);
  }

  .services__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: 0.375rem;
  }

  .services__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-dark);
    line-height: 1.3;
  }

  .services__price {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-taupe);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .services__desc {
    font-size: 0.875rem;
    color: var(--color-text-dark-muted);
    max-width: 42ch;
  }

  .services__cta {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-taupe);
    transition: color var(--transition-fast);
  }

  @media (min-width: 768px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
