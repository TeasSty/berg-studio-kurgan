---
import { site } from '../data/site';
---

<section class="final-cta section" id="contact" aria-labelledby="final-cta-title">
  <div class="final-cta__bg" aria-hidden="true"></div>
  <div class="container final-cta__inner">
    <h2 class="final-cta__title reveal" id="final-cta-title">
      Записаться<br />на консультацию
    </h2>
    <p class="final-cta__text reveal reveal-delay-1">
      Напишите в VK или позвоните — обсудим запрос и подберём время.
    </p>

    <div class="final-cta__actions reveal reveal-delay-2">
      <a href={site.vkMessage} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
        Написать в VK
      </a>
      <a href={`tel:${site.phone}`} class="btn btn--ghost">
        {site.phoneDisplay}
      </a>
    </div>

    <address class="final-cta__address reveal reveal-delay-3">
      <p class="final-cta__address-line">{site.fullAddress}</p>
      <p class="final-cta__address-line">{site.hours}</p>
    </address>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .final-cta__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 50% at 50% 100%,
      rgba(196, 176, 138, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .final-cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final-cta__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    max-width: 14ch;
    color: var(--color-ivory);
  }

  .final-cta__text {
    margin-top: var(--space-md);
    max-width: 36ch;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .final-cta__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    width: 100%;
    max-width: 320px;
  }

  .final-cta__address {
    margin-top: var(--space-2xl);
    padding: var(--space-lg) var(--space-xl);
    border: 1px solid rgba(196, 176, 138, 0.2);
    font-style: normal;
    text-align: center;
  }

  .final-cta__address-line {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-ivory);
    line-height: 1.5;
  }

  .final-cta__address-line + .final-cta__address-line {
    margin-top: 0.375rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-taupe);
  }

  @media (min-width: 480px) {
    .final-cta__actions {
      flex-direction: row;
      justify-content: center;
      max-width: none;
      width: auto;
    }
  }
</style>
